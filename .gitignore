# --- Secretos y configuración local ---
# .env.dev y .env.test contienen credenciales: nunca se versionan.
# .env.example sí se versiona (es la plantilla sin valores reales).
.env
.env.*
!.env.example

# --- Maven ---
target/
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# --- Logs y archivos generados ---
logs/
*.log
trips.log
hs_err_pid*

# Salidas de consola y notas sueltas.
# Si alguno ya estaba versionado, hay que sacarlo con: git rm --cached <archivo>
*.txt
*.bat

# --- Documentación y herramientas locales ---
HELP.md
qodana.yaml
guide/

# --- Clases compiladas ---
*.class

