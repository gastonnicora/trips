# Plantilla de variables de entorno de Trips.
#
# Desarrollo: copiá este archivo como .env.dev y completá los valores.
# Tests:      creá un .env.test con GEOCODING_CONTACT_EMAIL (el resto está en
#             application-test.properties).
# Producción: definí estas mismas variables en el entorno del servidor.
#
# Formato .properties: sin comillas ni espacios alrededor del "=".
# .env.dev y .env.test están en .gitignore; no los subas nunca.

# --- Base de datos (MySQL) ---
DB_URL=jdbc:mysql://localhost:3306/db_dev_trips
DB_USER=root
DB_PASSWORD=cambiar

# --- JWT ---
# Mínimo 32 caracteres. Generá uno propio, por ejemplo con: openssl rand -hex 32
JWT_SECRET=cambiar-por-una-clave-de-al-menos-32-caracteres

# --- Superadmin inicial (se crea al arrancar si todavía no existe) ---
SUPER_EMAIL=admin@ejemplo.com
SUPER_PASSWORD=cambiar

# --- Geocodificación (Nominatim) ---
# Su política de uso exige un contacto en el User-Agent.
GEOCODING_CONTACT_EMAIL=tu-email@ejemplo.com